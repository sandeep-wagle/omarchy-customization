#!/usr/bin/env python3
"""omarchy-emulator-snap — keep the Android Emulator at a slim 460px column.

Problem: Hyprland tiles the emulator into a wide 50/50 split, but the phone
renders at ~480px (1080x2424 panel, no device frame), so bundled Qt fills the
rest with a blinding white canvas.

This daemon listens on Hyprland's socket2 for `openwindow>>` events. When the
main phone window (class Emulator / qemu-system-x86_64, the large tiled one —
NOT the 54px toolbar or extended-controls dialogs) opens, it snaps the width
to exactly 460px via the Hyprland-Lua dispatch verified live on this machine:

    hl.dsp.focus({ window = "address:0xADDR" })
    hl.dsp.window.resize({ x = 460, y = <current height> })

Focus is saved and restored around the resize (two jumps inside ~100ms).
Classic `resizewindowpixel` does NOT work on Hyprland-Lua builds — the plain
form hangs hyprctl with no reply — hence the focus/resize/restore sequence.

Qt keeps self-resizing while the emulator boots (minimum width grows
430 -> 496 -> 634 during boot, then settles once the home screen is up), so
one snap is not enough: retries run at +2s/+6s/+12s after open, plus a poll
enforcer every 5s re-snaps tiled emulator windows that are still too wide —
but ONLY within 3 minutes of opening, so later manual Super+RightClick drags
are left alone.

Single-instance via pidfile. Never raises; logs to
~/.local/state/omarchy/emulator-snap.log.
"""

import json
import os
import re
import socket
import subprocess
import sys
import threading
import time
from pathlib import Path

HOME = os.path.expanduser("~")
LOG = Path(HOME) / ".local" / "state" / "omarchy" / "emulator-snap.log"
PIDFILE = Path(HOME) / ".local" / "state" / "omarchy" / "emulator-snap.pid"

TARGET_W = 460
MIN_SNAP_W = 200   # windows narrower than this are the toolbar/dialogs: skip
SKIP_W_TOL = 15    # already within TARGET_W +- tol: skip
SETTLE_S = 0.8     # wait for map + tiling before first snap
RETRIES_S = (2.0, 6.0, 12.0)  # Qt self-resizes during boot: re-check thrice
ENFORCE_S = 5.0    # poll enforcer interval
ENFORCE_WINDOW_S = 180.0  # only enforce within 3 min of open (manual drags win after)

MAIN_CLASS = re.compile(r"^(Emulator|emulator|qemu-system-x86_64)$")

# addr -> monotonic() timestamp of last openwindow>> (bounds the enforcer so
# it never fights deliberate Super+RightClick resizes made later).
OPEN_TIMES = {}
OPEN_LOCK = threading.Lock()

# addr -> consecutive clamped (no-op) snap count. Qt enforces its own minimum
# width (grows while booting / when zoomed in); resizing below it is a no-op
# that still steals focus twice, so after 2 clamped attempts we back off and
# leave the window alone until it is closed/reopened.
CLAMPED = {}
CLAMPED_LOCK = threading.Lock()
MAX_CLAMPED = 2

# addr -> last seen (w, h). While Android boots, Qt reshapes the window
# repeatedly (huge white canvas -> shrinking as the home screen appears). A
# significant reshape means the Qt minimum moved, so any backoff for that
# address is stale and gets one more chance. Threshold keeps dwindle jitter
# from resetting the backoff.
LAST_SEEN = {}
RESHAPE_PX = 60


def log(msg):
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        if LOG.is_file() and LOG.stat().st_size > 200 * 1024:
            LOG.unlink()
        with open(LOG, "a") as f:
            f.write(f"{time.strftime('%F %T')} {msg}\n")
    except Exception:
        pass


def run(cmd, timeout=12):
    try:
        return subprocess.run(cmd, capture_output=True, timeout=timeout).stdout.decode("utf-8", "replace")
    except Exception:
        return ""


def hyprctl_j(args):
    try:
        return json.loads(run(["hyprctl", "-j"] + args).strip() or "null")
    except Exception:
        return None


def dispatch(lua):
    run(["hyprctl", "dispatch", lua])


def socket2_path():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    rt = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    if sig:
        p = Path(rt) / "hypr" / sig / ".socket2.sock"
        if p.exists():
            return str(p)
    try:
        cands = sorted(Path(rt, "hypr").glob("*/.socket2.sock"),
                       key=lambda p: p.stat().st_mtime, reverse=True)
        if cands:
            return str(cands[0])
    except Exception:
        pass
    return None


def norm_addr(raw):
    raw = (raw or "").strip().split(",")[0]
    if not raw:
        return ""
    return raw if raw.startswith("0x") else "0x" + raw


def single_instance():
    try:
        PIDFILE.parent.mkdir(parents=True, exist_ok=True)
        if PIDFILE.is_file():
            try:
                old = int(PIDFILE.read_text().strip())
            except ValueError:
                old = 0
            if old and old != os.getpid():
                try:
                    os.kill(old, 0)
                    return False
                except (ProcessLookupError, PermissionError):
                    pass
        PIDFILE.write_text(str(os.getpid()))
    except Exception:
        pass
    return True


def find_window(addr):
    clients = hyprctl_j(["clients"])
    if not isinstance(clients, list):
        return None
    addr = addr.lower()
    for w in clients:
        if isinstance(w, dict) and str(w.get("address", "")).lower() == addr:
            return w
    return None


def snap(addr):
    """Snap one window to TARGET_W, preserving height. Returns True if done."""
    w = find_window(addr)
    if not w:
        return True  # closed meanwhile: nothing to do
    cls = str(w.get("class", ""))
    if not MAIN_CLASS.match(cls):
        return True
    if w.get("floating"):
        return True  # toolbar / dialogs float: leave alone
    try:
        if int(w.get("fullscreen", 0) or 0) != 0:
            return True
    except Exception:
        pass
    try:
        cur_w, cur_h = int(w["size"][0]), int(w["size"][1])
    except Exception:
        return True
    if cur_w < MIN_SNAP_W or cur_h < MIN_SNAP_W:
        return True  # toolbar-sized (vertical bar or horizontal strip): skip
    if abs(cur_w - TARGET_W) <= SKIP_W_TOL:
        with CLAMPED_LOCK:
            CLAMPED.pop(addr.lower(), None)
        return True  # already narrow
    with CLAMPED_LOCK:
        if CLAMPED.get(addr.lower(), 0) >= MAX_CLAMPED:
            return False  # Qt clamped us before: backed off, no focus steal
    prev = hyprctl_j(["activewindow"])
    prev_addr = prev.get("address") if isinstance(prev, dict) else None
    dispatch(f'hl.dsp.focus({{ window = "address:{addr}" }})')
    time.sleep(0.15)
    dispatch(f"hl.dsp.window.resize({{ x = {TARGET_W}, y = {cur_h} }})")
    time.sleep(0.4)  # let Qt/XWayland settle so the re-read is truthful
    if prev_addr and prev_addr != addr:
        dispatch(f'hl.dsp.focus({{ window = "address:{prev_addr}" }})')
    new_w = find_window(addr)
    try:
        got_w = int(new_w["size"][0]) if new_w else cur_w
        got_h = int(new_w["size"][1]) if new_w else cur_h
    except Exception:
        got_w, got_h = cur_w, cur_h
    with CLAMPED_LOCK:
        LAST_SEEN[addr.lower()] = (got_w, got_h)
    if got_w > TARGET_W + SKIP_W_TOL:
        with CLAMPED_LOCK:
            n = CLAMPED.get(addr.lower(), 0) + 1
            CLAMPED[addr.lower()] = n
        log(f"snap {addr} ({cls}) {cur_w}x{cur_h} -> {TARGET_W}x{cur_h} "
            f"CLAMPED at {got_w}px ({n}/{MAX_CLAMPED})")
        return False
    with CLAMPED_LOCK:
        CLAMPED.pop(addr.lower(), None)
    log(f"snap {addr} ({cls}) {cur_w}x{cur_h} -> {TARGET_W}x{cur_h}")
    return True


def handle_open(addr):
    with OPEN_LOCK:
        OPEN_TIMES[addr.lower()] = time.monotonic()
    with CLAMPED_LOCK:
        CLAMPED.pop(addr.lower(), None)  # fresh window: clear old backoff
    time.sleep(SETTLE_S)
    if not snap(addr):
        return  # Qt minimum above target: backed off, enforcer will retry
    for wait in RETRIES_S:
        time.sleep(wait)
        w = find_window(addr)
        if not w:
            return
        try:
            cur_w = int(w["size"][0])
        except Exception:
            return
        if cur_w > TARGET_W + SKIP_W_TOL and not w.get("floating"):
            try:
                if int(w.get("fullscreen", 0) or 0) != 0:
                    return
            except Exception:
                pass
            log(f"retry {addr}: still {cur_w}px, snapping again")
            if not snap(addr):
                return
        else:
            return


def list_main_windows():
    clients = hyprctl_j(["clients"])
    if not isinstance(clients, list):
        return []
    out = []
    for w in clients:
        if not isinstance(w, dict):
            continue
        if not MAIN_CLASS.match(str(w.get("class", ""))):
            continue
        if w.get("floating"):
            continue
        try:
            if int(w.get("fullscreen", 0) or 0) != 0:
                continue
            cur_w = int(w["size"][0])
            cur_h = int(w["size"][1])
        except Exception:
            continue
        if cur_w < MIN_SNAP_W or cur_h < MIN_SNAP_W:
            continue
        if cur_w <= TARGET_W + SKIP_W_TOL:
            continue
        out.append((str(w.get("address", "")), cur_w))
    return out


def enforcer():
    """Poll loop: re-snap tiled emulator windows that Qt widened after boot.

    Only touches windows opened within ENFORCE_WINDOW_S, so manual resizes
    made later (Super+RightClick drag) are respected.
    """
    while True:
        try:
            now = time.monotonic()
            with OPEN_LOCK:
                recent = {a for a, t in OPEN_TIMES.items()
                          if now - t < ENFORCE_WINDOW_S}
                # prune stale entries to bound memory
                for a in [a for a, t in OPEN_TIMES.items()
                          if now - t >= ENFORCE_WINDOW_S]:
                    del OPEN_TIMES[a]
            for addr, cur_w in list_main_windows():
                if addr.lower() in recent:
                    w = find_window(addr)
                    try:
                        live = (int(w["size"][0]), int(w["size"][1])) if w else None
                    except Exception:
                        live = None
                    if live is not None:
                        with CLAMPED_LOCK:
                            prev = LAST_SEEN.get(addr.lower())
                            LAST_SEEN[addr.lower()] = live
                            if prev is not None and (
                                abs(live[0] - prev[0]) > RESHAPE_PX
                                or abs(live[1] - prev[1]) > RESHAPE_PX
                            ):
                                # Qt reshaped (boot progressing): old clamp
                                # verdict is stale, allow fresh attempts.
                                if CLAMPED.pop(addr.lower(), None) is not None:
                                    log(f"reshape {addr}: {prev[0]}x{prev[1]} -> "
                                        f"{live[0]}x{live[1]}, backoff cleared")
                    snap(addr)  # snap() logs; silent backoff when Qt clamps
        except Exception as e:
            log(f"enforcer: {e!r}")
        time.sleep(ENFORCE_S)


def main():
    if not single_instance():
        print("emulator-snap already running")
        return 0
    log("started")
    # Seed open-times with already-running emulator windows so the enforcer
    # picks up a session that was launched before this daemon (re)started.
    try:
        now = time.monotonic()
        with OPEN_LOCK:
            for addr, _cur_w in list_main_windows():
                OPEN_TIMES.setdefault(addr.lower(), now)
    except Exception:
        pass
    threading.Thread(target=enforcer, daemon=True).start()
    while True:
        sock = socket2_path()
        if not sock:
            log("no socket2; retrying")
            time.sleep(5)
            continue
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(30)
            s.connect(sock)
            buf = b""
            while True:
                try:
                    chunk = s.recv(4096)
                except socket.timeout:
                    continue
                if not chunk:
                    break
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    try:
                        ev = line.decode("utf-8", "replace").strip()
                    except Exception:
                        continue
                    if ev.startswith("openwindow>>"):
                        # payload: ADDRESS,WORKSPACE,CLASS,TITLE (title may
                        # hold commas; at open time it is often still the
                        # bare "Emulator", so match on class here and let
                        # snap() discriminate by live size afterwards).
                        parts = ev.split(">>", 1)[1].split(",", 3)
                        if len(parts) >= 3 and MAIN_CLASS.match(parts[2].strip()):
                            addr = norm_addr(parts[0])
                            threading.Thread(target=handle_open,
                                             args=(addr,), daemon=True).start()
        except Exception as e:
            log(f"socket loop: {e!r}")
        time.sleep(2.0)


if __name__ == "__main__":
    sys.exit(main())
