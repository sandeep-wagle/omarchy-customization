#!/usr/bin/env bash
# omarchy-display-mode — refresh-rate and layout control for Hyprland monitors.
#
# Backs the Display panel (com.sandy.display): applies changes live via
# `hyprctl eval "hl.monitor({...})"` and persists per-output rules to
# ~/.config/hypr/monitors.lua so they survive reboots and lid events.
#
# Usage:
#   omarchy-display-mode refresh <OUTPUT> <HZ>   # e.g. refresh eDP-1 144
#   omarchy-display-mode resolution <OUTPUT> <WxH> # e.g. resolution HDMI-A-1 1280x720
#   omarchy-display-mode scale <OUTPUT> <SCALE>   # e.g. scale HDMI-A-1 1.25
#   omarchy-display-mode layout <MODE>           # extend-right|extend-left|
#                                                # extend-above|extend-below|
#                                                # mirror|internal-only|external-only
#   omarchy-display-mode cycle                   # next layout (Super+P)
#   omarchy-display-mode fallback                # internal-only if no external
#   omarchy-display-mode connected               # physically connected outputs
#   omarchy-display-mode rates <OUTPUT>          # list "WxH@RRHz" modes for output
#   omarchy-display-mode resolutions <OUTPUT>    # list "WxH (aspect)" modes for output
#   omarchy-display-mode gpu                     # print integrated|hybrid|nvidia|dedicated|unknown
#   omarchy-display-mode gpu-set <MODE>          # igpu|hybrid|dgpu (notifies if re-login needed)
set -u

MONITOR_LUA="${HOME}/.config/hypr/monitors.lua"

usage() {
  cat <<'EOF'
Usage:
  omarchy-display-mode refresh <OUTPUT> <HZ>
  omarchy-display-mode layout <extend-right|extend-left|extend-above|extend-below|mirror|internal-only|external-only>
  omarchy-display-mode cycle
  omarchy-display-mode fallback
  omarchy-display-mode connected
  omarchy-display-mode rates <OUTPUT>
EOF
}

monitors_json() {
  hyprctl monitors all -j 2>/dev/null
}

# Outputs the kernel reports as physically connected. `hyprctl monitors all`
# also lists DISABLED and STALE outputs, so it cannot answer "is the HDMI still
# plugged in?" — the DRM status file can.
physically_connected() {
  local f name
  for f in /sys/class/drm/card*-*/status; do
    [ -r "$f" ] || continue
    [ "$(cat "$f" 2>/dev/null)" = "connected" ] || continue
    name="$(basename "$(dirname "$f")")"
    name="${name#card[0-9]*-}"
    printf '%s\n' "$name"
  done
}

drm_available() {
  local f
  for f in /sys/class/drm/card*-*/status; do
    [ -r "$f" ] && return 0
  done
  return 1
}

# Echo "<internal> <external>". The external is the first non-internal output
# that is PHYSICALLY connected; when DRM info is unavailable, fall back to the
# old behaviour (first non-internal entry in Hyprland's list).
internal_external() {
  local j="$1"
  local internal external name connected
  internal="$(echo "$j" | jq -r '[.[] | select(.name | test("^(eDP|LVDS|DSI)-"))][0].name // ""')"
  external=""
  connected="$(physically_connected)"
  if [ -n "$connected" ]; then
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      if printf '%s\n' "$connected" | grep -qx -- "$name"; then
        external="$name"
        break
      fi
    done < <(echo "$j" | jq -r '.[] | select((.name | test("^(eDP|LVDS|DSI)-")) | not) | .name')
  else
    external="$(echo "$j" | jq -r '[.[] | select((.name | test("^(eDP|LVDS|DSI)-")) | not)][0].name // ""')"
  fi
  printf '%s %s\n' "$internal" "$external"
}

valid_name() {
  [[ $1 =~ ^[A-Za-z0-9._-]+$ ]]
}

# Replace (or append) a per-output hl.monitor rule in monitors.lua.
# The generic `output = ""` fallback line is left untouched.
persist_rule() {
  local output="$1" rule="$2"
  [ -f "$MONITOR_LUA" ] || return 0
  local esc
  esc="$(printf '%s' "$output" | sed 's/[.[\*^$/]/\\&/g')"
  if grep -Eq "^hl\.monitor\(\{ output = \"${esc}\"," "$MONITOR_LUA"; then
    local tmp
    tmp="$(mktemp)" || return 0
    sed -E "s|^hl\\.monitor\\(\\{ output = \"${esc}\",.*|${rule}|" "$MONITOR_LUA" >"$tmp" \
      && cat "$tmp" >"$MONITOR_LUA"
    rm -f "$tmp"
  else
    printf '%s\n' "$rule" >>"$MONITOR_LUA"
  fi
}

cmd_rates() {
  local output="$1"
  valid_name "$output" || { echo "Refusing unsafe monitor name" >&2; exit 1; }
  monitors_json | jq -r --arg o "$output" \
    '.[] | select(.name == $o) | .availableModes[]'
}

cmd_refresh() {
  local output="$1" want_hz="$2"
  valid_name "$output" || { echo "Refusing unsafe monitor name" >&2; exit 1; }
  [[ $want_hz =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "HZ must be numeric" >&2; exit 1; }

  local j info w h x y scale
  j="$(monitors_json)"
  info="$(echo "$j" | jq -e -c --arg o "$output" '.[] | select(.name == $o)')"
  w="$(echo "$info" | jq -r '.width')"
  h="$(echo "$info" | jq -r '.height')"
  x="$(echo "$info" | jq -r '.x')"
  y="$(echo "$info" | jq -r '.y')"
  scale="$(echo "$info" | jq -r '.scale')"

  # Pick the available mode for HZ:
  #   1. same resolution, rounded refresh == HZ (exact step, e.g. 144);
  #   2. any resolution with rounded refresh == HZ, largest area first
  #      (this is what makes a guaranteed 60Hz baseline work on modes
  #      like 1152x864 that only expose 75Hz — it drops to 1920x1080@60);
  #   3. closest refresh overall (last resort for odd HZ values).
  local mode
  mode="$(echo "$info" | jq -r --argjson w "$w" --argjson h "$h" --argjson hz "$want_hz" '
    def rounded: (.rr | tonumber + 0.5 | floor);
    [.availableModes[] | capture("^(?<mw>[0-9]+)x(?<mh>[0-9]+)@(?<rr>[0-9.]+)Hz$")]
    | (map(select((.mw | tonumber) == $w and (.mh | tonumber) == $h and rounded == ($hz | floor))) | min_by(.rr | tonumber)) as $same
    | (map(select(rounded == ($hz | floor))) | max_by((.mw | tonumber) * (.mh | tonumber) * 1000000 - ((.rr | tonumber) - $hz | if . < 0 then -. else . end))) as $any
    | (min_by((.rr | tonumber) - $hz | if . < 0 then -. else . end)) as $near
    | ($same // $any // $near)
    | "\(.mw)x\(.mh)@\(.rr)"')"
  if [ -z "$mode" ] || [ "$mode" = "null" ]; then
    echo "No ${w}x${h} mode near ${want_hz}Hz on ${output}" >&2
    exit 1
  fi

  hyprctl eval "hl.monitor({ output = \"$output\", mode = \"$mode\", position = \"${x}x${y}\", scale = $scale })" >/dev/null
  persist_rule "$output" "hl.monitor({ output = \"$output\", mode = \"$mode\", position = \"${x}x${y}\", scale = $scale })"
  echo "ok $output $mode"
}

# Common aspect-ratio label for WxH (16:9, 16:10, 21:9, 32:9, 4:3, 5:4,
# 3:2, 1:1); falls back to the reduced ratio (e.g. 43:18) when uncommon.
aspect_of() {
  local w="$1" h="$2"
  awk -v w="$w" -v h="$h" '
    function gcd(a, b, t) { while (b) { t = a % b; a = b; b = t } return a }
    BEGIN {
      g = gcd(w, h); rw = w / g; rh = h / g
      if (rw == 16 && rh == 9) a = "16:9"
      else if ((rw == 16 && rh == 10) || (rw == 8 && rh == 5)) a = "16:10"
      else if (rw == 64 && rh == 27) a = "21:9"
      else if (rw == 43 && rh == 18) a = "21:9"
      else if (rw == 32 && rh == 9) a = "32:9"
      else if (rw == 4 && rh == 3) a = "4:3"
      else if (rw == 5 && rh == 4) a = "5:4"
      else if (rw == 3 && rh == 2) a = "3:2"
      else if (rw == 1 && rh == 1) a = "1:1"
      else if (rw == 21 && rh == 9) a = "21:9"
      else a = rw ":" rh
      print a
    }'
}

cmd_resolutions() {
  local output="$1"
  valid_name "$output" || { echo "Refusing unsafe monitor name" >&2; exit 1; }
  local j info
  j="$(monitors_json)"
  info="$(echo "$j" | jq -e -c --arg o "$output" '.[] | select(.name == $o)')"
  echo "$info" | jq -r '.availableModes[]' | sed -E 's/@[0-9.]+Hz$//' | sort -u -t x -k1,1nr -k2,2nr | while read -r res; do
    w="${res%x*}"; h="${res#*x}"
    printf '%s (%s)\n' "$res" "$(aspect_of "$w" "$h")"
  done
}

cmd_resolution() {
  local output="$1" res="$2"
  valid_name "$output" || { echo "Refusing unsafe monitor name" >&2; exit 1; }
  [[ $res =~ ^[0-9]+x[0-9]+$ ]] || { echo "Resolution must look like 1920x1080" >&2; exit 1; }

  local j info w h cur_rr x y scale
  j="$(monitors_json)"
  info="$(echo "$j" | jq -e -c --arg o "$output" '.[] | select(.name == $o)')"
  w="${res%x*}"; h="${res#*x}"
  cur_rr="$(echo "$info" | jq -r '.refreshRate')"
  x="$(echo "$info" | jq -r '.x')"
  y="$(echo "$info" | jq -r '.y')"
  scale="$(echo "$info" | jq -r '.scale')"

  # Keep the refresh closest to the current one at the new resolution.
  local mode
  mode="$(echo "$info" | jq -r --arg r "$res" --argjson rr "$cur_rr" '
    [.availableModes[] | select(startswith($r + "@")) | capture("@(?<v>[0-9.]+)Hz$") | .v]
    | if length == 0 then empty
      else (. | min_by((tonumber) - $rr | if . < 0 then -. else . end)) as $best
      | "\($r)@\($best)" end')"
  if [ -z "$mode" ] || [ "$mode" = "null" ]; then
    echo "Resolution $res not available on $output" >&2
    exit 1
  fi

  hyprctl eval "hl.monitor({ output = \"$output\", mode = \"$mode\", position = \"${x}x${y}\", scale = $scale })" >/dev/null
  persist_rule "$output" "hl.monitor({ output = \"$output\", mode = \"$mode\", position = \"${x}x${y}\", scale = $scale })"
  echo "ok $output $mode"
}

cmd_scale() {
  local output="$1" new_scale="$2"
  valid_name "$output" || { echo "Refusing unsafe monitor name" >&2; exit 1; }
  [[ $new_scale =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "SCALE must be numeric" >&2; exit 1; }

  local j info mode x y
  j="$(monitors_json)"
  info="$(echo "$j" | jq -e -c --arg o "$output" '.[] | select(.name == $o)')"
  mode="$(echo "$info" | jq -r '"\(.width)x\(.height)@\(.refreshRate)"')"
  x="$(echo "$info" | jq -r '.x')"
  y="$(echo "$info" | jq -r '.y')"

  hyprctl eval "hl.monitor({ output = \"$output\", mode = \"$mode\", position = \"${x}x${y}\", scale = $new_scale })" >/dev/null
  persist_rule "$output" "hl.monitor({ output = \"$output\", mode = \"$mode\", position = \"${x}x${y}\", scale = $new_scale })"
  echo "ok $output scale $new_scale"
}

# Apply and persist one complete monitor rule. `disabled = false` is explicit:
# after a previous disable, a rule without the field can leave the output off.
apply_monitor() { # output mode position scale [extra-fields...]
  local o="$1" m="$2" p="$3" s="$4" extra="${5:-}"
  local fields="mode = \"$m\", position = \"$p\", scale = $s, disabled = false"
  [ -n "$extra" ] && fields="$fields, $extra"
  hyprctl eval "hl.monitor({ output = \"$o\", $fields })" >/dev/null
  persist_rule "$o" "hl.monitor({ output = \"$o\", $fields })"
}

disable_output() { # output
  local o="$1"
  hyprctl eval "hl.monitor({ output = \"$o\", disabled = true })" >/dev/null
  persist_rule "$o" "hl.monitor({ output = \"$o\", disabled = true })"
}

logical_size() { # monitor-json -> "w h" in logical (layout) pixels
  echo "$1" | jq -r '"\((.width / .scale) | round) \((.height / .scale) | round)"'
}

cmd_layout() {
  local mode="$1"
  local j internal external
  j="$(monitors_json)"
  read -r internal external <<<"$(internal_external "$j")"
  if [ -z "$internal" ]; then
    echo "No internal display found; refusing layout change" >&2
    exit 1
  fi
  if [ "$mode" != "internal-only" ] && [ -z "$external" ]; then
    echo "No external display connected; refusing $mode" >&2
    exit 1
  fi
  valid_name "$internal" || { echo "Refusing unsafe monitor name" >&2; exit 1; }
  if [ -n "$external" ]; then
    valid_name "$external" || { echo "Refusing unsafe monitor name" >&2; exit 1; }
  fi

  local int_info ext_info int_mode int_scale ext_mode ext_scale
  int_info="$(echo "$j" | jq -e -c --arg o "$internal" '.[] | select(.name == $o)')"
  int_mode="$(echo "$int_info" | jq -r '"\(.width)x\(.height)@\(.refreshRate)"')"
  int_scale="$(echo "$int_info" | jq -r '.scale')"
  if [ -n "$external" ]; then
    ext_info="$(echo "$j" | jq -e -c --arg o "$external" '.[] | select(.name == $o)')"
    ext_mode="$(echo "$ext_info" | jq -r '"\(.width)x\(.height)@\(.refreshRate)"')"
    ext_scale="$(echo "$ext_info" | jq -r '.scale')"
  fi

  local int_w int_h ext_w ext_h
  read -r int_w int_h <<<"$(logical_size "$int_info")"
  [ -n "$external" ] && read -r ext_w ext_h <<<"$(logical_size "$ext_info")"

  local pos_int pos_ext extra_ext=""
  case "$mode" in
    extend-right) pos_int="0x0"; pos_ext="${int_w}x0" ;;
    extend-left) pos_int="${ext_w}x0"; pos_ext="0x0" ;;
    extend-above) pos_int="0x${ext_h}"; pos_ext="0x0" ;;
    extend-below) pos_int="0x0"; pos_ext="0x${int_h}" ;;
    mirror) pos_int="0x0"; pos_ext="0x0"; extra_ext="mirror = \"$internal\"" ;;
    internal-only)
      apply_monitor "$internal" "$int_mode" "0x0" "$int_scale"
      [ -n "$external" ] && disable_output "$external"
      echo "ok internal-only"; return 0 ;;
    external-only)
      apply_monitor "$external" "$ext_mode" "0x0" "$ext_scale"
      disable_output "$internal"
      echo "ok external-only"; return 0 ;;
    *) echo "Unknown layout: $mode" >&2; usage >&2; exit 1 ;;
  esac

  apply_monitor "$internal" "$int_mode" "$pos_int" "$int_scale"
  apply_monitor "$external" "$ext_mode" "$pos_ext" "$ext_scale" "$extra_ext"
  echo "ok $mode"
}

# Current arrangement, using the same rules as Model.detectLayout. Empty when
# undeterminable (no internal, or both outputs disabled).
current_layout() {
  local j="$1" internal external
  local idis edis dx dy mirror_of
  read -r internal external <<<"$(internal_external "$j")"
  [ -n "$internal" ] || { echo ""; return 0; }

  idis="$(echo "$j" | jq -r --arg o "$internal" '.[] | select(.name == $o) | (.disabled == true)')"
  if [ -z "$external" ]; then
    if [ "$idis" = "true" ]; then echo ""; else echo "internal-only"; fi
    return 0
  fi
  edis="$(echo "$j" | jq -r --arg o "$external" '.[] | select(.name == $o) | (.disabled == true)')"
  if [ "$edis" = "true" ] && [ "$idis" != "true" ]; then echo "internal-only"; return 0; fi
  if [ "$idis" = "true" ] && [ "$edis" != "true" ]; then echo "external-only"; return 0; fi
  if [ "$idis" = "true" ] && [ "$edis" = "true" ]; then echo ""; return 0; fi

  mirror_of="$(echo "$j" | jq -r --arg i "$internal" --arg e "$external" \
    '[.[] | select((.name == $i or .name == $e) and .mirrorOf != "none")][0].mirrorOf // "none"')"
  [ "$mirror_of" != "none" ] && { echo "mirror"; return 0; }

  read -r dx dy < <(echo "$j" | jq -r --arg i "$internal" --arg e "$external" '
    ([.[] | select(.name == $e)][0]) as $ext
    | ([.[] | select(.name == $i)][0]) as $int
    | "\(($ext.x - $int.x)) \(($ext.y - $int.y))"')
  if [ "$dx" -gt 0 ] 2>/dev/null; then echo "extend-right"; return 0; fi
  if [ "$dx" -lt 0 ] 2>/dev/null; then echo "extend-left"; return 0; fi
  if [ "$dy" -lt 0 ] 2>/dev/null; then echo "extend-above"; return 0; fi
  if [ "$dy" -gt 0 ] 2>/dev/null; then echo "extend-below"; return 0; fi
  echo ""
}

layout_label() {
  case "$1" in
    extend-right) echo "Extend right" ;;
    extend-left) echo "Extend left" ;;
    extend-above) echo "Extend above" ;;
    extend-below) echo "Extend below" ;;
    mirror) echo "Mirror" ;;
    internal-only) echo "Internal only" ;;
    external-only) echo "External only" ;;
    *) echo "$1" ;;
  esac
}

notify_layout() {
  notify-send -u low -h string:x-canonical-private-synchronous:display-layout \
    "Display" "$1" 2>/dev/null || true
}

# Super+P: walk the layout list. Serialised so rapid keypresses apply in
# order instead of racing each other and repeating the same mode.
cmd_cycle() {
  local lock="${XDG_RUNTIME_DIR:-/tmp}/omarchy-display-cycle.lock"
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$lock" 2>/dev/null || true
    flock -w 3 9 2>/dev/null || return 0
  fi

  local j internal external cur next i
  local order=(extend-right extend-left extend-above extend-below mirror internal-only external-only)
  j="$(monitors_json)"
  read -r internal external <<<"$(internal_external "$j")"
  if [ -z "$external" ]; then
    cmd_fallback
    notify_layout "No external display connected"
    return 0
  fi

  cur="$(current_layout "$j")"
  next="${order[0]}"
  if [ -n "$cur" ]; then
    for i in "${!order[@]}"; do
      if [ "${order[$i]}" = "$cur" ]; then
        next="${order[$(( (i + 1) % ${#order[@]} ))]}"
        break
      fi
    done
  fi
  if cmd_layout "$next" >/dev/null 2>&1; then
    notify_layout "Layout: $(layout_label "$next")"
  fi
}

# Safety net for unplugging: when no external output is physically connected,
# re-enable the internal panel at the origin and disable stale externals. This
# is what stops an "External only" selection from leaving a black screen.
cmd_fallback() {
  local j internal external idis x y o stale_enabled
  j="$(monitors_json)"
  [ -n "$j" ] || return 0
  read -r internal external <<<"$(internal_external "$j")"
  [ -n "$internal" ] || return 0
  [ -z "$external" ] || return 0

  idis="$(echo "$j" | jq -r --arg o "$internal" '.[] | select(.name == $o) | (.disabled == true)')"
  x="$(echo "$j" | jq -r --arg o "$internal" '.[] | select(.name == $o) | .x')"
  y="$(echo "$j" | jq -r --arg o "$internal" '.[] | select(.name == $o) | .y')"

  # A disconnected output can linger in `monitors all` as ENABLED; its old
  # position is what produces the "monitor overlaps" warning. Treat that as
  # unsafe too, even when the internal panel already looks fine.
  stale_enabled=""
  if drm_available; then
    while IFS= read -r o; do
      [ -n "$o" ] || continue
      physically_connected | grep -qx -- "$o" && continue
      if [ "$(echo "$j" | jq -r --arg o "$o" '.[] | select(.name == $o) | (.disabled == true)')" != "true" ]; then
        stale_enabled="$o"
      fi
    done < <(echo "$j" | jq -r '.[] | select((.name | test("^(eDP|LVDS|DSI)-")) | not) | .name')
  fi

  if [ "$idis" != "true" ] && [ "$x" = "0" ] && [ "$y" = "0" ] && [ -z "$stale_enabled" ]; then
    return 0  # already safe: internal enabled at the origin, no ghost output
  fi

  cmd_layout internal-only >/dev/null 2>&1 || return 0

  # Disable every listed external that is no longer physically connected so
  # its stale position cannot overlap the internal panel.
  if drm_available; then
    while IFS= read -r o; do
      [ -n "$o" ] || continue
      physically_connected | grep -qx -- "$o" && continue
      disable_output "$o"
    done < <(echo "$j" | jq -r '.[] | select((.name | test("^(eDP|LVDS|DSI)-")) | not) | .name')
  fi
  notify_layout "External display removed. Switched to Internal only."
}

cmd_connected() {
  physically_connected
}

# ---- GPU mode (supergfxctl preferred, envycontrol fallback) ----
# Prints one of: integrated | hybrid | nvidia | dedicated | vfio | egpu | unknown
cmd_gpu() {
  if command -v supergfxctl >/dev/null 2>&1; then
    local g
    g="$(timeout 3 supergfxctl -g 2>/dev/null)" || g=""
    # Normalize: [Integrated], Hybrid, etc. -> lowercase bare word.
    g="$(printf '%s' "$g" | tr '[:upper:]' '[:lower:]' | tr -d '[] ')"
    case "$g" in
      integrated | hybrid | dedicated | nvidia | vfio | egpu | compute | none) printf '%s\n' "$g" ;;
      "") printf 'unknown\n' ;;
      *) printf '%s\n' "$g" ;;
    esac
    return 0
  fi
  if command -v envycontrol >/dev/null 2>&1; then
    timeout 5 envycontrol --query 2>/dev/null || printf 'unknown\n'
    return 0
  fi
  printf 'unknown\n'
}

# Switch GPU mode: igpu | hybrid | dgpu. Prints the resulting mode (or an
# explanatory line) and notifies when a re-login/reboot is required.
cmd_gpu_set() {
  local want="$1" target sgfx_target
  case "$want" in
    igpu | integrated) target="integrated"; sgfx_target="Integrated" ;;
    hybrid) target="hybrid"; sgfx_target="Hybrid" ;;
    dgpu | dedicated | nvidia) target="nvidia"; sgfx_target="Dedicated" ;;
    *) echo "MODE must be igpu|hybrid|dgpu" >&2; exit 1 ;;
  esac

  if command -v supergfxctl >/dev/null 2>&1; then
    if timeout 10 pkexec supergfxctl -m "$sgfx_target" 2>/dev/null \
       || timeout 10 supergfxctl -m "$sgfx_target" 2>/dev/null; then
      notify-send "GPU Mode" "Switched to ${want}. Please re-login to apply changes." 2>/dev/null || true
      cmd_gpu
      return 0
    fi
    echo "supergfxctl switch failed (is supergfxd running?)" >&2
    exit 1
  fi
  if command -v envycontrol >/dev/null 2>&1; then
    if timeout 30 pkexec envycontrol -s "$target" 2>/dev/null; then
      notify-send "GPU Mode" "Switched to ${want}. Please reboot to apply changes." 2>/dev/null || true
      cmd_gpu
      return 0
    fi
    echo "envycontrol switch failed" >&2
    exit 1
  fi
  notify-send "GPU Mode" "Install supergfxctl or envycontrol to switch GPU modes." 2>/dev/null || true
  echo "no GPU backend (install supergfxctl or envycontrol)" >&2
  exit 1
}

case "${1:-}" in
  refresh) [ $# -eq 3 ] || { usage >&2; exit 1; }; cmd_refresh "$2" "$3" ;;
  resolution) [ $# -eq 3 ] || { usage >&2; exit 1; }; cmd_resolution "$2" "$3" ;;
  scale) [ $# -eq 3 ] || { usage >&2; exit 1; }; cmd_scale "$2" "$3" ;;
  layout) [ $# -eq 2 ] || { usage >&2; exit 1; }; cmd_layout "$2" ;;
  cycle) cmd_cycle ;;
  fallback) cmd_fallback ;;
  connected) cmd_connected ;;
  rates) [ $# -eq 2 ] || { usage >&2; exit 1; }; cmd_rates "$2" ;;
  resolutions) [ $# -eq 2 ] || { usage >&2; exit 1; }; cmd_resolutions "$2" ;;
  gpu) cmd_gpu ;;
  gpu-set) [ $# -eq 2 ] || { usage >&2; exit 1; }; cmd_gpu_set "$2" ;;
  *) usage >&2; exit 1 ;;
esac
